<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>
    <groupId>com.tj</groupId>
    <artifactId>TJTrade</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <modules>
        <module>common-api</module>
        <module>user-service</module>
        <module>order-risk-service</module>
        <module>matching-engine-service</module>
        <module>portfolio-ledger-service</module>
        <module>market-data-service</module>
        <module>api-gateway</module>
        <module>integration-tests</module>
    </modules>
    <properties>
        <java.version>21</java.version>
        <maven.version>3.9.16</maven.version>
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <jjwt.version>0.11.5</jjwt.version>
        <postgres.image>postgres:16.13-alpine3.23</postgres.image>
        <redis.image>redis:7.4.8-alpine</redis.image>
        <kafka.image>apache/kafka:4.2.1</kafka.image>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <classifier>exec</classifier>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>21</release>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>platform-contract</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,22)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9.16,3.9.17)</version>
                                </requireMavenVersion>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>net.devh:*</exclude>
                                        <exclude>org.springframework.grpc:spring-grpc-*-spring-boot-starter</exclude>
                                        <exclude>com.fasterxml.jackson.core:jackson-databind:(,2.21.5)</exclude>
                                        <exclude>io.grpc:*:(,1.83.1)</exclude>
                                        <exclude>com.google.protobuf:protobuf-java:(,4.35.1)</exclude>
                                    </excludes>
                                    <searchTransitive>true</searchTransitive>
                                </bannedDependencies>
                                <dependencyConvergence>
                                    <includes>
                                        <include>io.grpc:*</include>
                                        <include>com.google.protobuf:*</include>
                                        <include>org.apache.kafka:*</include>
                                        <include>tools.jackson.core:*</include>
                                        <include>com.fasterxml.jackson.core:*</include>
                                        <include>org.jooq:*</include>
                                    </includes>
                                </dependencyConvergence>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
